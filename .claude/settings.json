{
  "permissions": {
    "allow": [
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 180,
            "statusMessage": "Running lint + typecheck"
          }
        ]
      }
    ]
  }
}
